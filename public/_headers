# Security headers for every page and file on roster.scottforge.ai, /oh/ included.
#
# The content security policy is report-only: a violation is printed in the
# browser console and nothing is blocked. The two __CSP_*_HASHES__ slots are
# filled with the hashes of the built pages' inline scripts and styles by
# scripts/stamp-csp.mjs, and the build fails if it cannot find them.
#
# frame-ancestors is ignored in a report-only policy, so framing is refused by
# an enforcing policy of its own and by X-Frame-Options for older browsers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__ https://static.cloudflareinsights.com; style-src 'self' __CSP_STYLE_HASHES__; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://jkuocstqtveuymfqqlwg.supabase.co https://cloudflareinsights.com https://static.cloudflareinsights.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'
