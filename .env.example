# Copy to .env.local and fill in after creating the Supabase project.
#
# Leave this unset and the app runs entirely on-device with no sign-in — which
# is a perfectly good way to use it, and how it behaves before setup.
#
# This is a public URL, not a secret. The database is unreachable from the
# browser; everything goes through the edge function, which checks the team
# code and holds the only credentials.
VITE_API_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/api
