# Copy to .env.local for development. Both values are safe to publish — the anon
# key is designed to ship inside the JavaScript bundle, and what it can reach is
# fixed by supabase/migrations/0001_shared_roster.sql, not by keeping it secret.
#
# Leave these unset and the app builds without the share feature: the code box
# and the publish panel hide themselves rather than offering buttons that fail.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
